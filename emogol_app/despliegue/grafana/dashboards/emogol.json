{
 "title": "EmoGol: servicio de inferencia",
 "uid": "emogol",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Mensajes clasificados por segundo",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (origen) (rate(emogol_mensajes_total[30s]))",
     "legendFormat": "{{origen}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "msg/s"
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Latencia p50 y p95 (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(emogol_latencia_segundos_bucket[30s])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(emogol_latencia_segundos_bucket[30s])))",
     "legendFormat": "p95"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Mensajes en cola",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "emogol_cola_mensajes",
     "legendFormat": "cola"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Tamaño medio de lote",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(emogol_tamano_lote_sum[30s]) / rate(emogol_tamano_lote_count[30s])",
     "legendFormat": "lote"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Uso de GPU (%)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "emogol_gpu_uso_porcentaje",
     "legendFormat": "GPU"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Memoria de GPU (MiB)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "emogol_gpu_memoria_mib",
     "legendFormat": "VRAM"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "decmbytes"
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Uso de CPU (%)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 16
   },
   "targets": [
    {
     "refId": "A",
     "expr": "emogol_cpu_porcentaje",
     "legendFormat": "CPU"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "RAM (MiB)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 16
   },
   "targets": [
    {
     "refId": "A",
     "expr": "emogol_ram_mib",
     "legendFormat": "máquina"
    },
    {
     "refId": "B",
     "expr": "emogol_ram_proceso_mib",
     "legendFormat": "servicio"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "decmbytes"
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Aciertos de la caché (%)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 16
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * sum(rate(emogol_mensajes_total{origen=\"cache\"}[1m])) / sum(rate(emogol_mensajes_total[1m]))",
     "legendFormat": "caché"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   }
  }
 ],
 "tags": [
  "emogol"
 ]
}